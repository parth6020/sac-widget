{
  "name": "AI Insight Chat v2",
  "description": "Ask Claude/OpenAI questions about this dashboard",
  "newInstancePrefix": "AIChatV2",
  "vendor": "iOCFO",
  "id": "com.iocfo.ai.chat.v2",
  "version": "2.0.0",
  "icon": "",
  "eula": "",
  "license": "",
  "webcomponents": [
    {
      "kind": "main",
      "tag": "ai-chat-widget-v2",
      "url": "https://cdn.jsdelivr.net/gh/parth6020/sac-widget@main/widget.js",
      "integrity": "",
      "ignoreIntegrity": true
    }
  ],
  "properties": {
    "proxyUrl": {
      "type": "string",
      "description": "URL of your BTP proxy /ai-insight endpoint",
      "default": "https://sac-ai-proxy.cfapps.eu10.hana.ondemand.com/ai-insight"
    },
    "provider": {
      "type": "string",
      "description": "AI provider: 'claude' or 'openai'",
      "default": "claude"
    }
  },
  "methods": {},
  "events": {
    "onInsightReceived": {
      "description": "Fired when AI response arrives"
    }
  },
  "dataBindings": {
    "myDataBinding": {
      "feeds": [
        { "id": "dimensions", "description": "Dimensions", "type": "dimension" },
        { "id": "measures", "description": "Measures", "type": "mainStructureMember" }
      ]
    }
  }
}
